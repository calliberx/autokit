# ===============================================
# Evolution API v2 - Environment Configuration
# ===============================================
SERVER_URL=https://evo.yourdomain.com
AUTHENTICATION_API_KEY=your-authentication-api-key

QRCODE_LIMIT=30        # seconds the QR stays valid
CONFIG_SESSION_PHONE_NAME="Chrome"
# Kept in sync with EVOLUTION_PHONE_VERSION in docker-compose.yml.
CONFIG_SESSION_PHONE_VERSION=2.3000.1040516757

WEBSOCKET_ENABLED=true
WEBSOCKET_GLOBAL_EVENTS=false
N8N_COMMUNITY_NODES_ENABLED=true

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:your-url-encoded-password@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=your-secure-evolution-db-password

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/1
CACHE_REDIS_PREFIX_KEY=evo_v2

CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_CREDENTIALS=true
