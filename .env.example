# ======================
# Core secrets (setup.sh generates these)
# ======================
POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=your-secure-postgres-password
EVOLUTION_DB_PASSWORD=your-secure-evolution-db-password
N8N_ENCRYPTION_KEY=your-hex-encryption-key-min-24-chars
N8N_USER_MANAGEMENT_JWT_SECRET=your-jwt-secret
N8N_RUNNERS_AUTH_TOKEN=your-runners-auth-token

# ======================
# Mode: domain vs IP:port
# ======================
# WITH a domain:    TRAEFIK_ENABLED=true, ports stay bound to 127.0.0.1
# WITHOUT a domain: TRAEFIK_ENABLED=false and publish directly, e.g.
#                   N8N_PUBLISH_PORT=0.0.0.0:5678
#                   EVOLUTION_PUBLISH_PORT=0.0.0.0:8080
TRAEFIK_ENABLED=true
N8N_PUBLISH_PORT=127.0.0.1:5678
EVOLUTION_PUBLISH_PORT=127.0.0.1:8080

# ======================
# Domain configuration (ignored when TRAEFIK_ENABLED=false)
# ======================
N8N_DOMAIN=n8n.yourdomain.com
EVOLUTION_DOMAIN=evo.yourdomain.com
SSL_EMAIL=your-email@example.com

# ======================
# Public URLs
# ======================
N8N_HOST=${N8N_DOMAIN}
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_EDITOR_BASE_URL=https://${N8N_DOMAIN}/
WEBHOOK_URL=https://${N8N_DOMAIN}/

# ======================
# Database
# ======================
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=${POSTGRES_DB}
DB_POSTGRESDB_USER=${POSTGRES_USER}
DB_POSTGRESDB_PASSWORD=${POSTGRES_PASSWORD}

# ======================
# Execution (queue mode)
# ======================
EXECUTIONS_MODE=queue
QUEUE_BULL_REDIS_HOST=redis
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_DB=0

# ======================
# Runtime & options
# ======================
GENERIC_TIMEZONE=Asia/Jerusalem
N8N_DEFAULT_LOCALE=en
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RUNNERS_ENABLED=true
N8N_GIT_NODE_DISABLE_BARE_REPOS=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Required for the Evolution API community node used by the templates.
N8N_COMMUNITY_PACKAGES_ENABLED=true
